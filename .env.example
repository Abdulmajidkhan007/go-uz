# Vroom environment template — copy to .env and fill in.
# API mode switches packages/api between the mock and http clients.

# Shared (read by packages/config)
VROOM_API_MODE=mock
VROOM_API_BASE_URL=

# Mobile (Expo — must be prefixed EXPO_PUBLIC_ to reach the client bundle)
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_BASE_URL=

# Web (Vite — must be prefixed VITE_ to reach the client bundle)
VITE_API_MODE=mock
VITE_API_BASE_URL=
