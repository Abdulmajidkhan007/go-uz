# Vroom environment template — copy to .env and fill in.
# The API layer (@vroom/api) switches between the mock and http clients based
# on the API mode. loadConfig() reads the unprefixed names; each app maps its
# platform-prefixed vars onto them (Expo requires EXPO_PUBLIC_, Vite VITE_).
#
# mode = "mock"  -> in-memory mock backend (no base URL needed)
# mode = "http"  -> real backend; base URL is REQUIRED

# --- Shared (read by packages/config loadConfig) ---
VROOM_API_MODE=mock
VROOM_API_BASE_URL=

# --- Mobile (apps/mobile, Expo) — must be prefixed EXPO_PUBLIC_ ---
EXPO_PUBLIC_VROOM_API_MODE=mock
EXPO_PUBLIC_VROOM_API_BASE_URL=

# --- Web (apps/web, Vite) — must be prefixed VITE_ ---
VITE_VROOM_API_MODE=mock
VITE_VROOM_API_BASE_URL=

# --- Admin (apps/admin, Vite) — shares the same VITE_ vars ---
# VITE_VROOM_API_MODE=http
# VITE_VROOM_API_BASE_URL=https://api.vroom.example.com
