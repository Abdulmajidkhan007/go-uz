# Vroom environment template — copy to .env and fill in.
# The API layer (@vroom/api) switches between the mock and http clients based
# on the API mode. loadConfig() reads the unprefixed names; web apps map their
# platform-prefixed vars onto them (Vite VITE_), while the bare RN CLI mobile
# app reads the unprefixed names directly via react-native-config.
#
# mode = "mock"  -> in-memory mock backend (no base URL needed)
# mode = "http"  -> real backend; base URL is REQUIRED

# --- Shared (read by packages/config loadConfig) ---
VROOM_API_MODE=mock
VROOM_API_BASE_URL=

# --- Mobile (apps/mobile, bare React Native CLI) ---
# These live in apps/mobile/.env and are consumed at build time via
# react-native-config (import Config from 'react-native-config'). Bare names,
# no platform prefix.
VROOM_API_MODE=mock
VROOM_API_BASE_URL=

# --- Web (apps/web, Vite) — must be prefixed VITE_ ---
VITE_VROOM_API_MODE=mock
VITE_VROOM_API_BASE_URL=

# --- Admin (apps/admin, Vite) — shares the same VITE_ vars ---
# VITE_VROOM_API_MODE=http
# VITE_VROOM_API_BASE_URL=https://api.vroom.example.com

# ---------------------------------------------------------------------------
# Google Maps (single dev key for web + mobile)
# Enable: Maps SDK for Android, Maps JavaScript API, Places API, Directions API
# ---------------------------------------------------------------------------
VITE_GOOGLE_MAPS_KEY=
# Mobile (apps/mobile/.env, via react-native-config)
GOOGLE_MAPS_KEY=

# ---------------------------------------------------------------------------
# Firebase backend (optional — used by @vroom/api/firebase)
# Copy these from your Firebase project's web app config.
# Web uses VITE_ prefix and maps onto the bare VROOM_FIREBASE_* names that
# loadFirebaseConfig() reads. Mobile (bare RN CLI) reads the bare names directly
# via react-native-config from apps/mobile/.env.
# ---------------------------------------------------------------------------
VITE_VROOM_FIREBASE_API_KEY=
VITE_VROOM_FIREBASE_AUTH_DOMAIN=
VITE_VROOM_FIREBASE_PROJECT_ID=
VITE_VROOM_FIREBASE_APP_ID=
VITE_VROOM_FIREBASE_STORAGE_BUCKET=
VITE_VROOM_FIREBASE_MESSAGING_SENDER_ID=

# Mobile (apps/mobile/.env, via react-native-config)
VROOM_FIREBASE_API_KEY=
VROOM_FIREBASE_AUTH_DOMAIN=
VROOM_FIREBASE_PROJECT_ID=
VROOM_FIREBASE_APP_ID=
VROOM_FIREBASE_STORAGE_BUCKET=
VROOM_FIREBASE_MESSAGING_SENDER_ID=
